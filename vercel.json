{
  "version": 2,
  "builds": [
    {
      "src": "web_terminal_chat.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "web_terminal_chat.py"
    }
  ],
  "functions": {
    "web_terminal_chat.py": {
      "maxDuration": 60
    }
  }
}
